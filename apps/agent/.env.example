# LiveKit Server Configuration (leave empty, add your credentials when ready)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent Dispatch Name
AGENT_NAME=DD_agent

# --- TTS provider selection ---
# 'rime-plugin' -> Rime over WebSocket, word timestamps (JUDGED PATH; requires RIME_API_KEY)
# 'rime'        -> Rime via LiveKit Inference (disclosed fallback, no timestamps, no key)
# 'fishaudio'   -> pre-Rime baseline, keeps expressive mode
TTS_PROVIDER=rime-plugin
RIME_API_KEY=

# Rime voice/model (applies to both Rime paths).
# Voice names are model-specific: 'celeste' is a coda voice. A voice that does
# not exist for the chosen model fails at synthesis time, mid-call.
RIME_MODEL=coda
RIME_VOICE=celeste
# 3-letter code (the plugin's native format): eng | spa | fra | ger
RIME_LANGUAGE=eng

# Optional speech-rate multiplier (>1 slower, <1 faster). Left unset = Rime default (1.0).
# The factory routes this to the right per-model option name automatically.
RIME_SPEED=

# --- Cartograph demo/bench knobs ---
# Artificial delay (ms) injected into staging tool calls. 0 for the normal and
# judged flow (mutations draw as their sentence is spoken); set 5000 only for
# the interruption stress demo, where the tool is still in flight when the user
# cuts in so the fence rejects it. This is the DETERMINISTIC test fixture the
# benchmark relies on and is kept deliberately (TECHNICAL_REVIEW.md §5.4).
SLOW_TOOL_MS=0
# The REAL slow tool (explainComponent) does a live Wikipedia lookup by default,
# with a fixture for ~20 common infra terms. Set to 'fixture' on stage to skip
# the network entirely — a live fetch on stage is a failure point.
COMPONENT_LOOKUP=live
# The agent-side ELK layout direction: RIGHT (left-to-right layers) or DOWN.
LAYOUT_DIRECTION=RIGHT
# true = disable generation fencing + the commit gate (the naive-agent comparison mode).
CARTOGRAPH_BASELINE=false

# --- LLM engine kill switch (see LANGGRAPH_PLAN.md) ---
# 'direct' -> today's single inference.LLM call (default)
# 'graph'  -> LangGraph planning/routing via CanvasAgent.llmNode; tools are still
#             executed by LiveKit, never by the graph, so fencing is unaffected.
# No new secret: the graph authenticates to LiveKit Inference with the same
# LIVEKIT_API_KEY/SECRET above, not a new API key.
LLM_ENGINE=direct
GRAPH_LLM_MODEL=google/gemma-4-31b-it

# --- Ambient meeting mode (see TECHNICAL_REVIEW.md §2) ---
# true = listen to EVERY participant in the room, not just the one AgentSession
# binds to. A second engineer's overheard speech can only ever create or destroy
# *proposals* (dashed "ghost" nodes) — committed canvas state still changes only
# on speech addressed to the agent. Off by default: needs a two-browser-tab live
# check that has not happened yet.
ADDRESSIVITY=false
# Classification threshold τ in [0,1]. A score at/above it counts as positive.
# Lower = the agent speaks/draws more eagerly (more false triggers).
ADDRESSIVITY_THRESHOLD=0.6
# Which withStructuredOutput() method the gateway+model combination supports.
# Verified against google/gemma-4-31b-it via probe-structured.ts: jsonSchema and
# jsonMode both fail to parse (the model doesn't reliably emit raw JSON matching
# the schema); functionCalling is the one that works.
GRAPH_STRUCTURED_METHOD=functionCalling
